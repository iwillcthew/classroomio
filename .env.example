# Docker resolves api and storage by service name; host-run apps use 127.0.0.1 instead.
# BETTER_AUTH_SECRET must be random; PRIVATE_SERVER_KEY must be random and match the API and dashboard.

PUBLIC_IS_SELFHOSTED=true
PUBLIC_IS_AI_ENABLED=true
PUBLIC_GOOGLE_AUTH_ENABLED=false
LMS_ALLOWED_EMAILS=admin@example.test,hocvien@example.test

POSTGRES_DB=mp_learning
POSTGRES_USER=mp_learning
POSTGRES_PASSWORD=replace-with-postgres-password

BETTER_AUTH_SECRET=
PRIVATE_SERVER_KEY=

DASHBOARD_ORIGIN=http://localhost:3082
TRUSTED_ORIGINS=http://localhost:3082
PUBLIC_SERVER_URL=http://localhost:3082
PRIVATE_SERVER_URL=http://api:3081
PRIVATE_APP_HOST=localhost
PRIVATE_APP_SUBDOMAINS=app

OBJECT_STORAGE_ENDPOINT=http://storage:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY_ID=mp-learning
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=http://localhost:9000/media
OBJECT_STORAGE_BUCKET_MEDIA=media
OBJECT_STORAGE_BUCKET_DOCUMENTS=documents
OBJECT_STORAGE_BUCKET_VIDEOS=videos

CIO_TELEMETRY_DISABLED=true
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER="MP Learning <replace-with-your-mailbox@example.com>"

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=

CSP_FRAME_SRC_DOMAINS=https://www.youtube.com,https://youtube.com,https://www.youtube-nocookie.com,https://player.vimeo.com,https://*.vimeo.com,https://vimeo.com,https://www.google.com,https://drive.google.com,https://docs.google.com,https://www.canva.com,https://canva.com,https://onedrive.live.com,https://*.onedrive.live.com,https://*.officeapps.live.com,https://1drv.ms,https://*.sharepoint.com,https://www.icloud.com,https://embed.figma.com,https://www.figma.com,https://prezi.com,https://pitch.com,https://gamma.app,https://www.slideshare.net,https://www.beautiful.ai
CSP_SCRIPT_SRC_DOMAINS=https://www.youtube.com,https://youtube.com,https://cdnjs.cloudflare.com,https://apis.google.com
CSP_STYLE_SRC_DOMAINS=https://cdn.plyr.io,https://unpkg.com,https://fonts.googleapis.com
CSP_CONNECT_SRC_DOMAINS=https://*.ytimg.com,https://noembed.com,https://www.googleapis.com,https://*.vimeo.com,https://vimeo.com,https://*.vimeocdn.com,https://cdn.plyr.io
CSP_FONT_SRC_DOMAINS=https://fonts.gstatic.com,https://cdn.plyr.io
CSP_MEDIA_SRC_DOMAINS=https://*
