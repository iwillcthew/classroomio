# syntax=docker/dockerfile:1
FROM node:24.22.1-slim AS base

WORKDIR /app

ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate

FROM base AS build

ARG PUBLIC_IS_SELFHOSTED=true

COPY . .

RUN --mount=type=cache,id=cio-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --ignore-scripts \
    --store-dir /pnpm/store --filter @cio/dashboard...
RUN find . -name 'tsconfig.tsbuildinfo' -delete
RUN NODE_OPTIONS="--max-old-space-size=8072" \
    PUBLIC_IS_SELFHOSTED="${PUBLIC_IS_SELFHOSTED}" \
    pnpm -r --filter @cio/dashboard... build

RUN test -f apps/dashboard/build/index.js || (echo "ERROR: Dashboard build output not found at apps/dashboard/build/index.js" && exit 1)
RUN find . -name node_modules -type d -prune -exec rm -rf {} + \
    && rm -rf apps/dashboard/.svelte-kit

FROM base

COPY --from=build /app /app

# Workspace packages declare zod as a peer; without dev deps Node only finds it hoisted to /app.
# Hoisting is safe here because this stage only runs the build output, never `vite build`.
RUN --mount=type=cache,id=cio-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --prod --frozen-lockfile --ignore-scripts --shamefully-hoist \
    --store-dir /pnpm/store --filter @cio/dashboard...

EXPOSE 3000

ENV NODE_ENV=production \
    PORT=3000 \
    PUBLIC_IS_SELFHOSTED=true

WORKDIR /app/apps/dashboard
CMD ["node", "build/index.js"]
