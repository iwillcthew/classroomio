# syntax=docker/dockerfile:1
FROM node:24.22.1-slim AS base

WORKDIR /app

# Keep install non-interactive and deterministic in CI/container contexts.
ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate

FROM base AS build

COPY . .

RUN --mount=type=cache,id=cio-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --ignore-scripts --shamefully-hoist \
    --store-dir /pnpm/store --filter @cio/api...
RUN find . -name 'tsconfig.tsbuildinfo' -delete
RUN pnpm -r --filter @cio/api... build
RUN find . -name node_modules -type d -prune -exec rm -rf {} +

FROM base

COPY --from=build /app /app

# entrypoint.sh runs `pnpm --filter @cio/db db:setup`, which needs tsx from @cio/db's
# devDependencies; the --prod install skips those.
RUN --mount=type=cache,id=cio-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --prod --frozen-lockfile --ignore-scripts --shamefully-hoist \
    --store-dir /pnpm/store --filter @cio/api... \
    && npm install -g tsx@4.21.0 \
    && npm cache clean --force

COPY docker/entrypoint-api.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 3081

ENV NODE_ENV=production \
    PORT=3081

# classroomio.sh checks this before moving an install onto the bundled SeaweedFS store.
LABEL com.classroomio.storage.seaweedfs-ready="true"

ENTRYPOINT ["/app/entrypoint.sh"]
