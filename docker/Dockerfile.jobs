# syntax=docker/dockerfile:1
FROM node:24.22.1-bookworm-slim AS base

WORKDIR /app

# Keep install non-interactive and deterministic in CI/container contexts.
ENV CI=true
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.19.0 --activate

FROM base AS build

COPY . .

RUN --mount=type=cache,id=cio-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --ignore-scripts \
    --store-dir /pnpm/store --filter @cio/jobs-worker...
RUN find . -name 'tsconfig.tsbuildinfo' -delete
RUN pnpm -r --filter @cio/jobs-worker... build
RUN find . -name node_modules -type d -prune -exec rm -rf {} +

FROM base

# ffmpeg is needed for media probe / thumbnail / audio-extract / transcode tasks.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app /app

# Workspace packages declare zod as a peer; without dev deps Node only finds it hoisted to /app.
RUN --mount=type=cache,id=cio-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --prod --frozen-lockfile --ignore-scripts --shamefully-hoist \
    --store-dir /pnpm/store --filter @cio/jobs-worker...

# Reported in self-hosted usage pings. Set last so a new version doesn't bust the build cache.
ARG CIO_VERSION=dev
ENV CIO_VERSION=$CIO_VERSION

# Run all worker entrypoints by default. Override CMD to scale media / transcribe
# / maintenance independently.
CMD ["node", "apps/jobs/dist/index.js"]
