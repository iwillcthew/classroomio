# DATABASE_URL credentials must match the root .env Postgres settings.
# PRIVATE_SERVER_KEY must be random and match apps/dashboard/.env; BETTER_AUTH_SECRET must be random.

PUBLIC_IS_SELFHOSTED=true
PUBLIC_IS_AI_ENABLED=true
PUBLIC_GOOGLE_AUTH_ENABLED=false
LMS_ALLOWED_EMAILS=admin@example.test,hocvien@example.test

DATABASE_URL=postgresql://mp_learning:replace-with-postgres-password@127.0.0.1:5432/mp_learning
REDIS_URL=redis://127.0.0.1:6379
PORT=3081

BETTER_AUTH_SECRET=
PRIVATE_SERVER_KEY=

DASHBOARD_ORIGIN=http://localhost:3082
TRUSTED_ORIGINS=http://localhost:3082
PUBLIC_SERVER_URL=http://localhost:3082

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY_ID=mp-learning
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=http://localhost:9000/media
OBJECT_STORAGE_BUCKET_MEDIA=media
OBJECT_STORAGE_BUCKET_DOCUMENTS=documents
OBJECT_STORAGE_BUCKET_VIDEOS=videos

CIO_TELEMETRY_DISABLED=true
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER="MP Learning <replace-with-your-mailbox@example.com>"

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
